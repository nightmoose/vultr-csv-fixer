# Copy to .env and fill in the key. Never commit .env.

# Vultr Serverless Inference (OpenAI-compatible).
# Leave the key empty to stay on the deterministic mock model.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Model id from the Vultr Serverless Inference catalog.
# Default glm-5.3-flash answers in about 7s.
# qwen3.8-flash-next is a fine fallback (about 14s).
# gpt-oss-120b is not in the catalog. A request for it can be answered by a
# different model, run for minutes, and hit the client timeout with no code.
VULTR_INFERENCE_MODEL=glm-5.3-flash

# MOCK_LLM=0 uses Vultr Serverless Inference when the key is set.
# MOCK_LLM=1 forces the deterministic offline model (hostile first attempt
# on poisoned fixtures, then a safe repair).
MOCK_LLM=0

# Sandbox
SANDBOX_IMAGE=csv-fixer-sandbox:local
SANDBOX_TIMEOUT_SEC=30
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
# FORCE_MOCK_SANDBOX=1 skips Docker and is for laptops and CI.
# On the VM leave this at 0 so repairs run in throwaway containers.
FORCE_MOCK_SANDBOX=0

MAX_AGENT_RETRIES=3
MAX_UPLOAD_BYTES=2000000

# Host port published by docker compose.
PORT=8080

# Absolute path used for job files on BOTH the host and the API container.
# Leave unset to use /var/lib/csvfix-work. Do not point this at a container-only /tmp.
# HOST_DATA_DIR=/var/lib/csvfix-work
