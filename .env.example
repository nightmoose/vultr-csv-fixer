# Vultr Serverless Inference (OpenAI-compatible)
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=gpt-oss-120b

# Local demo: set MOCK_LLM=1 to skip real Inference calls
MOCK_LLM=1

# Sandbox
SANDBOX_IMAGE=csv-fixer-sandbox:local
SANDBOX_TIMEOUT_SEC=30
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
# FORCE_MOCK_SANDBOX=1 skips docker even if the daemon is up (CI)
FORCE_MOCK_SANDBOX=0
